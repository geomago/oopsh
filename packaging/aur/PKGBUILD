# Maintainer: Giorgio Di Falco <https://github.com/geomago>
pkgname=oopsh
pkgver=1.0.1
pkgrel=1
pkgdesc='Corrects your previous console command (maintained fork of thefuck)'
arch=('any')
url='https://github.com/geomago/oopsh'
license=('MIT')
depends=('python' 'python-colorama' 'python-decorator' 'python-psutil' 'python-pyte')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
checkdepends=('python-pytest' 'python-pytest-mock')
source=("https://files.pythonhosted.org/packages/source/o/oopsh/oopsh-$pkgver.tar.gz")
sha256sums=('b17e19725d1b57544e3faa0649e25b2220c11fa2eb50a1def422f8222ac668b0')

build() {
  cd "$pkgname-$pkgver"
  python -m build --wheel --no-isolation
}

check() {
  cd "$pkgname-$pkgver"
  pytest -q --ignore=tests/functional
}

package() {
  cd "$pkgname-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE.md "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
