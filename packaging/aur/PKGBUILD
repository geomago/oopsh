# Maintainer: Giorgio Di Falco <https://github.com/geomago>
pkgname=oopsh
pkgver=1.0.0
pkgrel=1
pkgdesc='Corrects your previous console command (maintained fork of thefuck)'
arch=('any')
url='https://github.com/geomago/oopsh'
license=('MIT')
depends=('python' 'python-colorama' 'python-decorator' 'python-psutil' 'python-pyte')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
checkdepends=('python-pytest' 'python-pytest-mock')
# The GitHub archive, unlike the 1.0.0 sdist, has the whole test suite
source=("$pkgname-$pkgver.tar.gz::https://github.com/geomago/oopsh/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('a3df3c993b26b26c854ec551beb7a6ff6e2d127d974bd46a587b6b10dd23e8be')

build() {
  cd "$pkgname-$pkgver"
  python -m build --wheel --no-isolation
}

check() {
  cd "$pkgname-$pkgver"
  pytest -q --ignore=tests/functional
}

package() {
  cd "$pkgname-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE.md "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
